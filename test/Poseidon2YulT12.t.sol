    /// @dev inputs at or above PRIME are reduced by the library
    function test_input_sanitization() public view {
        uint256[12] memory a;
        uint256[12] memory b;
        for (uint256 i = 0; i < 12; i++) {
            a[i] = i + 5;
            b[i] = PRIME + i + 5;
        }
        assertEq(_permute(a), _permute(b), "sanitization");
        for (uint256 i = 0; i < 12; i++) {
            a[i] = type(uint256).max % PRIME;
            b[i] = type(uint256).max;
        }
        assertEq(_permute(a), _permute(b), "sanitization max");
    }

    /// @dev the library leaves the free memory pointer and the zero slot as it found them
    function test_memory_kept() public pure {
        uint256[12] memory state;
        uint256 fmp;
        assembly {
            fmp := mload(0x40)
        }
        LibPoseidon2YulT12.permute(state);
        uint256 fmpAfter;
        uint256 zero;
        assembly {
            fmpAfter := mload(0x40)
            zero := mload(0x60)
        }
        assertEq(fmpAfter, fmp, "free memory pointer");
        assertEq(zero, 0, "zero slot");
    }

    /// @dev the Yul and Huff permutations of the same width must agree on any input
    /// forge-config: default.fuzz.runs = 1000
    function testFuzz_matches_huff(uint256[12] memory input) public view {
        assertEq(_permute(input), _permuteHuff(input), "yul != huff");
    }
