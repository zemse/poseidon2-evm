        uint256 fmp;
        assembly {
            fmp := mload(0x40)
        }
        LibPoseidon2YulT8.permute(state);
        uint256 fmpAfter;
        uint256 zero;
        assembly {
            fmpAfter := mload(0x40)
            zero := mload(0x60)
        }
        assertEq(fmpAfter, fmp, "free memory pointer");
        assertEq(zero, 0, "zero slot");
    }

