import Poseidon2.Spec.Minpoly
import Poseidon2.Spec.DiagCheck

/-!
# The internal diagonal for t = 16 is the first draw passing the script's check

Draws 0 .. 5 fail `check_minpoly_condition`: the characteristic polynomial `f` of
their matrix `M` factors (`f = g · h`, both monic of degree at least 1), so the minimal
polynomial of `M ^ 1` is not irreducible of degree 16. Draw 6 passes it: `f` is
irreducible and `x ^ i` (`1 ≤ i ≤ 32`) lies in no proper subfield of `GF(P)[x] / f`.
Certificates written by `scripts/minpoly.mjs`, checked by kernel evaluation.
-/

namespace Poseidon2.Spec.MinpolyCheck.T16

open Minpoly DiagCheck

/-- Draw `j` (`j ≤ 6`), as `DiagCheck.drawRow_t16` gives it. -/
abbrev rowOf (j : Nat) : List Nat := ((diagValsT16.drop (j * 16)).take 16).map fun vs => vs.1 % P

/-- The monic product `g · h` without its leading `1`. -/
def fOf (g h : List Nat) : List Nat := (mulL (g ++ [1]) (h ++ [1])).take 16

