            // round 63 (external)
            let y0_63 := add(s0_62, 0x01fd6af15956294f9dfe38c0d976a088b21c21e4a1c2e823f912f44961f9a9ce)
            let x2_0_63 := mulmod(y0_63, y0_63, PRIME)
            let a0_63 := mulmod(mulmod(x2_0_63, x2_0_63, PRIME), y0_63, PRIME)
            let y1_63 := add(s1_62, 0x18e5abedd626ec307bca190b8b2cab1aaee2e62ed229ba5a5ad8518d4e5f2a57)
            let x2_1_63 := mulmod(y1_63, y1_63, PRIME)
            let a1_63 := mulmod(mulmod(x2_1_63, x2_1_63, PRIME), y1_63, PRIME)
            let y2_63 := add(s2_62, 0x0fc1bbceba0590f5abbdffa6d3b35e3297c021a3a409926d0e2d54dc1c84fda6)
            let x2_2_63 := mulmod(y2_63, y2_63, PRIME)
            let a2_63 := mulmod(mulmod(x2_2_63, x2_2_63, PRIME), y2_63, PRIME)
            let sum_63 := add(add(a0_63, a1_63), a2_63)
            let s0_63 := addmod(sum_63, a0_63, PRIME)
            let s1_63 := addmod(sum_63, a1_63, PRIME)
            let s2_63 := addmod(sum_63, a2_63, PRIME)

            mstore(state, s0_63)
            mstore(add(state, 0x20), s1_63)
            mstore(add(state, 0x40), s2_63)
        }
    }
