    dup5 dup5 add                            // [t0, t1, u7, u6, u4, u5, s8', s9', s10', s11', s12', s13', ...]
    [PRIME] dup2 dup5 dup1 add addmod        // [t3, t0, t1, u7, u6, u4, u5, s8', s9', s10', s11', s12', ...]
    [PRIME] dup4 dup9 dup1 add addmod        // [t2, t3, t0, t1, u7, u6, u4, u5, s8', s9', s10', s11', ...]
    [PRIME] dup3 dup2 dup7 0x4 mulmod addmod // [s7', t2, t3, t0, t1, u7, u6, u4, u5, s8', s9', s10', ...]
    [PRIME] dup3 dup3 addmod                 // [s6', s7', t2, t3, t0, t1, u7, u6, u4, u5, s8', s9', ...]
    [PRIME] dup4 dup2 dup8 0x4 mulmod addmod // [s5', s6', s7', t2, t3, t0, t1, u7, u6, u4, u5, s8', ...]
    [PRIME] dup6 dup3 addmod                 // [s4', s5', s6', s7', t2, t3, t0, t1, u7, u6, u4, u5, ...]
    swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop // [s4', s5', s6', s7', s8', s9', s10', s11', s12', s13', s14', s15', ...]
    0x640 mload 0xb00 mload add              // [u1, s4', s5', s6', s7', s8', s9', s10', s11', s12', s13', s14', ...]
    0x620 mload 0xb20 mload add              // [u0, u1, s4', s5', s6', s7', s8', s9', s10', s11', s12', s13', ...]
    0x600 mload 0xae0 mload add              // [u2, u0, u1, s4', s5', s6', s7', s8', s9', s10', s11', s12', ...]
    0x5e0 mload 0xac0 mload add              // [u3, u2, u0, u1, s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup2 dup2 add                            // [t1, u3, u2, u0, u1, s4', s5', s6', s7', s8', s9', s10', ...]
    dup5 dup5 add                            // [t0, t1, u3, u2, u0, u1, s4', s5', s6', s7', s8', s9', ...]
    [PRIME] dup2 dup5 dup1 add addmod        // [t3, t0, t1, u3, u2, u0, u1, s4', s5', s6', s7', s8', ...]
    [PRIME] dup4 dup9 dup1 add addmod        // [t2, t3, t0, t1, u3, u2, u0, u1, s4', s5', s6', s7', ...]
    [PRIME] dup3 dup2 dup7 0x4 mulmod addmod // [s3', t2, t3, t0, t1, u3, u2, u0, u1, s4', s5', s6', ...]
    [PRIME] dup3 dup3 addmod                 // [s2', s3', t2, t3, t0, t1, u3, u2, u0, u1, s4', s5', ...]
    [PRIME] dup4 dup2 dup8 0x4 mulmod addmod // [s1', s2', s3', t2, t3, t0, t1, u3, u2, u0, u1, s4', ...]
    [PRIME] dup6 dup3 addmod                 // [s0', s1', s2', s3', t2, t3, t0, t1, u3, u2, u0, u1, ...]
    swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]

    // State to memory
