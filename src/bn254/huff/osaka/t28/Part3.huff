    swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop // [s8', s9', s10', s11', s12', s13', s14', s15', s16', s17', s18', s19', ...]
    0x6c0 mload 0xb00 mload add              // [u5, s8', s9', s10', s11', s12', s13', s14', s15', s16', s17', s18', ...]
