    [PRIME] dup3 dup3 addmod dup1 0xc60 mstore // [s18', s19', t2, t3, t0, t1, u17, u16, u18, u19, s20', s21', ...]
    [PRIME] dup4 dup2 dup8 0x4 mulmod addmod dup1 0xc80 mstore // [s17', s18', s19', t2, t3, t0, t1, u17, u16, u18, u19, s20', ...]
    [PRIME] dup6 dup3 addmod dup1 0xca0 mstore // [s16', s17', s18', s19', t2, t3, t0, t1, u17, u16, u18, u19, ...]
    swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop // [s16', s17', s18', s19', s20', s21', s22', s23', s24', s25', s26', s27', ...]
    0x7a0 mload dup14 add                    // [u12, s16', s17', s18', s19', s20', s21', s22', s23', s24', s25', s26', ...]
    0x780 mload 0xae0 mload add              // [u14, u12, s16', s17', s18', s19', s20', s21', s22', s23', s24', s25', ...]
    0x760 mload 0xac0 mload add              // [u15, u14, u12, s16', s17', s18', s19', s20', s21', s22', s23', s24', ...]
    0x7c0 mload 0xb00 mload add              // [u13, u15, u14, u12, s16', s17', s18', s19', s20', s21', s22', s23', ...]
    dup3 dup3 add                            // [t1, u13, u15, u14, u12, s16', s17', s18', s19', s20', s21', s22', ...]
    dup5 dup3 add                            // [t0, t1, u13, u15, u14, u12, s16', s17', s18', s19', s20', s21', ...]
    [PRIME] dup2 dup6 dup1 add addmod        // [t3, t0, t1, u13, u15, u14, u12, s16', s17', s18', s19', s20', ...]
    [PRIME] dup4 dup6 dup1 add addmod        // [t2, t3, t0, t1, u13, u15, u14, u12, s16', s17', s18', s19', ...]
    [PRIME] dup3 dup2 dup7 0x4 mulmod addmod // [s15', t2, t3, t0, t1, u13, u15, u14, u12, s16', s17', s18', ...]
    [PRIME] dup3 dup3 addmod                 // [s14', s15', t2, t3, t0, t1, u13, u15, u14, u12, s16', s17', ...]
    [PRIME] dup4 dup2 dup8 0x4 mulmod addmod // [s13', s14', s15', t2, t3, t0, t1, u13, u15, u14, u12, s16', ...]
    [PRIME] dup6 dup3 addmod                 // [s12', s13', s14', s15', t2, t3, t0, t1, u13, u15, u14, u12, ...]
    swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop // [s12', s13', s14', s15', s16', s17', s18', s19', s20', s21', s22', s23', ...]
    0x740 mload 0xb00 mload add              // [u9, s12', s13', s14', s15', s16', s17', s18', s19', s20', s21', s22', ...]
    0x720 mload 0xb20 mload add              // [u8, u9, s12', s13', s14', s15', s16', s17', s18', s19', s20', s21', ...]
    0x700 mload 0xae0 mload add              // [u10, u8, u9, s12', s13', s14', s15', s16', s17', s18', s19', s20', ...]
    0x6e0 mload 0xac0 mload add              // [u11, u10, u8, u9, s12', s13', s14', s15', s16', s17', s18', s19', ...]
    dup2 dup2 add                            // [t1, u11, u10, u8, u9, s12', s13', s14', s15', s16', s17', s18', ...]
    dup5 dup5 add                            // [t0, t1, u11, u10, u8, u9, s12', s13', s14', s15', s16', s17', ...]
    [PRIME] dup2 dup5 dup1 add addmod        // [t3, t0, t1, u11, u10, u8, u9, s12', s13', s14', s15', s16', ...]
    [PRIME] dup4 dup9 dup1 add addmod        // [t2, t3, t0, t1, u11, u10, u8, u9, s12', s13', s14', s15', ...]
