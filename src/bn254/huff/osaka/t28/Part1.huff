    0xb20 mload 0x360 mstore                 // [s0', s14', s15', s16', s17', s18', s19', s20', s21', s22', s23', s24', ...]
}

/// @notice Part 1 entry: calldata = 28 words (reduced mod PRIME), returns what part 2 returns
#define macro MAIN() = {
    SETUP()                              // [PRIME]
    dup1 0x360 calldataload mod dup1 0x940 mstore // [s27, PRIME]
    dup2 0x340 calldataload mod dup1 0x920 mstore // [s26, s27, PRIME]
    dup3 0x320 calldataload mod dup1 0x900 mstore // [s25, s26, s27, PRIME]
    dup4 0x300 calldataload mod dup1 0x8e0 mstore // [s24, s25, s26, s27, PRIME]
    dup5 0x2e0 calldataload mod dup1 0x8c0 mstore // [s23, s24, s25, s26, s27, PRIME]
    dup6 0x2c0 calldataload mod dup1 0x8a0 mstore // [s22, s23, s24, s25, s26, s27, PRIME]
    dup7 0x2a0 calldataload mod dup1 0x880 mstore // [s21, s22, s23, s24, s25, s26, s27, PRIME]
    dup8 0x280 calldataload mod dup1 0x860 mstore // [s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    dup9 0x260 calldataload mod dup1 0x840 mstore // [s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    dup10 0x240 calldataload mod dup1 0x820 mstore // [s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    dup11 0x220 calldataload mod dup1 0x800 mstore // [s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    dup12 0x200 calldataload mod dup1 0x7e0 mstore // [s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    dup13 0x1e0 calldataload mod dup1 0x7c0 mstore // [s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    dup14 0x1c0 calldataload mod dup1 0x7a0 mstore // [s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    dup15 0x1a0 calldataload mod dup1 0x780 mstore // [s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    dup16 0x180 calldataload mod dup1 0x760 mstore // [s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    [PRIME] 0x160 calldataload mod dup1 0x740 mstore // [s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    [PRIME] 0x140 calldataload mod dup1 0x720 mstore // [s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    [PRIME] 0x120 calldataload mod dup1 0x700 mstore // [s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    [PRIME] 0x100 calldataload mod       // [s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    [PRIME] 0xe0 calldataload mod        // [s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    [PRIME] 0xc0 calldataload mod        // [s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    [PRIME] 0xa0 calldataload mod        // [s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    [PRIME] 0x80 calldataload mod        // [s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    [PRIME] 0x60 calldataload mod        // [s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    [PRIME] 0x40 calldataload mod        // [s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    [PRIME] 0x20 calldataload mod        // [s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]
    [PRIME] 0x0 calldataload mod         // [s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, PRIME]

    POSEIDON2_PART()                     // state at memory [0, 0x380)

    // forward the state to part 2 and return its output
    0x380 0x0 0x380 0x0 NEXT_PART() gas staticcall // [success]
    returndatasize 0x380 eq and ok jumpi
    0x0 0x0 revert
    ok:
    0x380 0x0 return
}

/// @notice Address of part 2: the word the deployer appends to the initcode, which CONSTRUCTOR keeps behind the runtime code
#define macro NEXT_PART() = {
    0x20 0x20 codesize sub 0x380 codecopy // memory[0x380] = address word
    0x380 mload                          // [next]
}

/// @notice Deploys the runtime code together with the word appended to the initcode
#define macro CONSTRUCTOR() = {
    __codesize(CONSTRUCTOR)              // [c]
    dup1 codesize sub                    // [len, c]
    dup1 swap2 0x0 codecopy              // [len]
    0x0 return
}
