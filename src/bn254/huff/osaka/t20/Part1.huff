/// @notice Part 1 entry: calldata = 20 words (reduced mod PRIME), returns the 20 words of the permutation output
#define macro MAIN() = {
    SETUP()                              // [PRIME]
    dup1 0x260 calldataload mod dup1 0x620 mstore // [s19, PRIME]
    dup2 0x240 calldataload mod dup1 0x600 mstore // [s18, s19, PRIME]
    dup3 0x220 calldataload mod dup1 0x5e0 mstore // [s17, s18, s19, PRIME]
    dup4 0x200 calldataload mod dup1 0x5c0 mstore // [s16, s17, s18, s19, PRIME]
