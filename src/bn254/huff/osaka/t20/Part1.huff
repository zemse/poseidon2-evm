    dup9 0x160 calldataload mod dup1 0x520 mstore // [s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup10 0x140 calldataload mod dup1 0x500 mstore // [s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup11 0x120 calldataload mod         // [s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup12 0x100 calldataload mod         // [s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup13 0xe0 calldataload mod          // [s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup14 0xc0 calldataload mod          // [s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup15 0xa0 calldataload mod          // [s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup16 0x80 calldataload mod          // [s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    [PRIME] 0x60 calldataload mod        // [s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    [PRIME] 0x40 calldataload mod        // [s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    [PRIME] 0x20 calldataload mod        // [s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    [PRIME] 0x0 calldataload mod         // [s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]

    POSEIDON2_PART()                     // state at memory [0, 0x280)

    0x280 0x0 return
}
