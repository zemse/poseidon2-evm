/// @notice Part 0 entry: calldata = 20 words (reduced mod PRIME), returns what part 1 returns
#define macro MAIN() = {
    SETUP()                              // [PRIME]
    dup1 0x260 calldataload mod dup1 0x760 mstore // [s19, PRIME]
    dup2 0x240 calldataload mod dup1 0x740 mstore // [s18, s19, PRIME]
    dup3 0x220 calldataload mod dup1 0x720 mstore // [s17, s18, s19, PRIME]
    dup4 0x200 calldataload mod dup1 0x700 mstore // [s16, s17, s18, s19, PRIME]
    dup5 0x1e0 calldataload mod dup1 0x6e0 mstore // [s15, s16, s17, s18, s19, PRIME]
    dup6 0x1c0 calldataload mod dup1 0x6c0 mstore // [s14, s15, s16, s17, s18, s19, PRIME]
    dup7 0x1a0 calldataload mod dup1 0x6a0 mstore // [s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup8 0x180 calldataload mod dup1 0x680 mstore // [s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup9 0x160 calldataload mod dup1 0x660 mstore // [s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup10 0x140 calldataload mod dup1 0x640 mstore // [s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup11 0x120 calldataload mod dup1 0x620 mstore // [s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup12 0x100 calldataload mod dup1 0x600 mstore // [s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup13 0xe0 calldataload mod dup1 0x5e0 mstore // [s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup14 0xc0 calldataload mod dup1 0x5c0 mstore // [s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup15 0xa0 calldataload mod dup1 0x5a0 mstore // [s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    dup16 0x80 calldataload mod dup1 0x580 mstore // [s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    [PRIME] 0x60 calldataload mod dup1 0x560 mstore // [s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    [PRIME] 0x40 calldataload mod dup1 0x540 mstore // [s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    [PRIME] 0x20 calldataload mod dup1 0x520 mstore // [s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]
    [PRIME] 0x0 calldataload mod dup1 0x500 mstore // [s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, PRIME]

    POSEIDON2_PART()                     // state at memory [0, 0x280)

    // forward the state to part 1 and return its output
    0x280 0x0 0x280 0x0 NEXT_PART() gas staticcall // [success]
    returndatasize 0x280 eq and ok jumpi
    0x0 0x0 revert
    ok:
    0x280 0x0 return
}

/// @notice Address of part 1: the word the deployer appends to the initcode, which CONSTRUCTOR keeps behind the runtime code
#define macro NEXT_PART() = {
    0x20 0x20 codesize sub 0x280 codecopy // memory[0x280] = address word
    0x280 mload                          // [next]
}

/// @notice Deploys the runtime code together with the word appended to the initcode
#define macro CONSTRUCTOR() = {
    __codesize(CONSTRUCTOR)              // [c]
    dup1 codesize sub                    // [len, c]
    dup1 swap2 0x0 codecopy              // [len]
    0x0 return
}
