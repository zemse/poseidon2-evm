    0x440 mload 0x180 mstore                 // [s0', s15', s6', sum, s9', s0^5, s10', s3', s13', s4', s14', P, ...]
    dup9 0x1a0 mstore                        // [s0', s15', s6', sum, s9', s0^5, s10', s3', s13', s4', s14', P, ...]
    dup11 0x1c0 mstore                       // [s0', s15', s6', sum, s9', s0^5, s10', s3', s13', s4', s14', P, ...]
    dup2 0x1e0 mstore                        // [s0', s15', s6', sum, s9', s0^5, s10', s3', s13', s4', s14', P, ...]
}

/// @notice Part 0 entry: calldata = 16 words (reduced mod PRIME), returns what part 1 returns
#define macro MAIN() = {
    SETUP()                              // [PRIME]
    dup1 0x1e0 calldataload mod dup1 0x5e0 mstore // [s15, PRIME]
    dup2 0x1c0 calldataload mod dup1 0x5c0 mstore // [s14, s15, PRIME]
    dup3 0x1a0 calldataload mod dup1 0x5a0 mstore // [s13, s14, s15, PRIME]
    dup4 0x180 calldataload mod dup1 0x580 mstore // [s12, s13, s14, s15, PRIME]
    dup5 0x160 calldataload mod dup1 0x560 mstore // [s11, s12, s13, s14, s15, PRIME]
    dup6 0x140 calldataload mod dup1 0x540 mstore // [s10, s11, s12, s13, s14, s15, PRIME]
    dup7 0x120 calldataload mod dup1 0x520 mstore // [s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup8 0x100 calldataload mod dup1 0x500 mstore // [s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup9 0xe0 calldataload mod dup1 0x4e0 mstore // [s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup10 0xc0 calldataload mod dup1 0x4c0 mstore // [s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup11 0xa0 calldataload mod dup1 0x4a0 mstore // [s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup12 0x80 calldataload mod dup1 0x480 mstore // [s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup13 0x60 calldataload mod dup1 0x460 mstore // [s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup14 0x40 calldataload mod dup1 0x440 mstore // [s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup15 0x20 calldataload mod dup1 0x420 mstore // [s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup16 0x0 calldataload mod dup1 0x400 mstore // [s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]

    POSEIDON2_PART()                     // state at memory [0, 0x200)

    // forward the state to part 1 and return its output
    0x200 0x0 0x200 0x0 NEXT_PART() gas staticcall // [success]
    returndatasize 0x200 eq and ok jumpi
    0x0 0x0 revert
    ok:
    0x200 0x0 return
}

/// @notice Address of part 1: the word the deployer appends to the initcode, which CONSTRUCTOR keeps behind the runtime code
#define macro NEXT_PART() = {
    0x20 0x20 codesize sub 0x200 codecopy // memory[0x200] = address word
    0x200 mload                          // [next]
}

/// @notice Deploys the runtime code together with the word appended to the initcode
#define macro CONSTRUCTOR() = {
    __codesize(CONSTRUCTOR)              // [c]
    dup1 codesize sub                    // [len, c]
    dup1 swap2 0x0 codecopy              // [len]
    0x0 return
}
