    dup13 dup4 dup9 dup1 add addmod          // [t2, t3, t0, t1, u14, u15, u12, u13, S0, S1, S2, S3, ...]
    dup14 dup3 dup2 dup7 0x4 mulmod addmod   // [s15', t2, t3, t0, t1, u14, u15, u12, u13, S0, S1, S2, ...]
    dup15 dup3 dup3 addmod                   // [s14', s15', t2, t3, t0, t1, u14, u15, u12, u13, S0, S1, ...]
    dup16 dup4 dup2 dup8 0x4 mulmod addmod   // [s13', s14', s15', t2, t3, t0, t1, u14, u15, u12, u13, S0, ...]
    [PRIME] dup6 dup3 addmod                 // [s12', s13', s14', s15', t2, t3, t0, t1, u14, u15, u12, u13, ...]
    swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop // [s12', s13', s14', s15', S0, S1, S2, S3, s14', P, s0', s1', ...]
    0x740 mload dup9 add                     // [u11, s12', s13', s14', s15', S0, S1, S2, S3, s14', P, s0', ...]
    0x720 mload dup7 add                     // [u8, u11, s12', s13', s14', s15', S0, S1, S2, S3, s14', P, ...]
    0x700 mload dup10 add                    // [u10, u8, u11, s12', s13', s14', s15', S0, S1, S2, S3, s14', ...]
    0x6e0 mload dup10 add                    // [u9, u10, u8, u11, s12', s13', s14', s15', S0, S1, S2, S3, ...]
    dup4 dup3 add                            // [t1, u9, u10, u8, u11, s12', s13', s14', s15', S0, S1, S2, ...]
    dup4 dup3 add                            // [t0, t1, u9, u10, u8, u11, s12', s13', s14', s15', S0, S1, ...]
    dup16 dup2 dup8 dup1 add addmod          // [t3, t0, t1, u9, u10, u8, u11, s12', s13', s14', s15', S0, ...]
    [PRIME] dup4 dup6 dup1 add addmod        // [t2, t3, t0, t1, u9, u10, u8, u11, s12', s13', s14', s15', ...]
    [PRIME] dup3 dup2 dup7 0x4 mulmod addmod // [s11', t2, t3, t0, t1, u9, u10, u8, u11, s12', s13', s14', ...]
    [PRIME] dup3 dup3 addmod                 // [s10', s11', t2, t3, t0, t1, u9, u10, u8, u11, s12', s13', ...]
    [PRIME] dup4 dup2 dup8 0x4 mulmod addmod // [s9', s10', s11', t2, t3, t0, t1, u9, u10, u8, u11, s12', ...]
    [PRIME] dup6 dup3 addmod                 // [s8', s9', s10', s11', t2, t3, t0, t1, u9, u10, u8, u11, ...]
    swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop // [s8', s9', s10', s11', s12', s13', s14', s15', S0, S1, S2, S3, ...]
    0x6c0 mload dup12 add                    // [u6, s8', s9', s10', s11', s12', s13', s14', s15', S0, S1, S2, ...]
    0x6a0 mload dup12 add                    // [u5, u6, s8', s9', s10', s11', s12', s13', s14', s15', S0, S1, ...]
    0x680 mload dup15 add                    // [u7, u5, u6, s8', s9', s10', s11', s12', s13', s14', s15', S0, ...]
    0x660 mload dup13 add                    // [u4, u7, u5, u6, s8', s9', s10', s11', s12', s13', s14', s15', ...]
    dup4 dup3 add                            // [t1, u4, u7, u5, u6, s8', s9', s10', s11', s12', s13', s14', ...]
    dup4 dup3 add                            // [t0, t1, u4, u7, u5, u6, s8', s9', s10', s11', s12', s13', ...]
    [PRIME] dup2 dup6 dup1 add addmod        // [t3, t0, t1, u4, u7, u5, u6, s8', s9', s10', s11', s12', ...]
    [PRIME] dup4 dup8 dup1 add addmod        // [t2, t3, t0, t1, u4, u7, u5, u6, s8', s9', s10', s11', ...]
    [PRIME] dup3 dup2 dup7 0x4 mulmod addmod // [s7', t2, t3, t0, t1, u4, u7, u5, u6, s8', s9', s10', ...]
    [PRIME] dup3 dup3 addmod                 // [s6', s7', t2, t3, t0, t1, u4, u7, u5, u6, s8', s9', ...]
    [PRIME] dup4 dup2 dup8 0x4 mulmod addmod // [s5', s6', s7', t2, t3, t0, t1, u4, u7, u5, u6, s8', ...]
    [PRIME] dup6 dup3 addmod                 // [s4', s5', s6', s7', t2, t3, t0, t1, u4, u7, u5, u6, ...]
    swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop // [s4', s5', s6', s7', s8', s9', s10', s11', s12', s13', s14', s15', ...]
    0x640 mload dup16 add                    // [u2, s4', s5', s6', s7', s8', s9', s10', s11', s12', s13', s14', ...]
    0x620 mload 0x7c0 mload add              // [u3, u2, s4', s5', s6', s7', s8', s9', s10', s11', s12', s13', ...]
    0x420 mload 0x7e0 mload add              // [u1, u3, u2, s4', s5', s6', s7', s8', s9', s10', s11', s12', ...]
    0x400 mload 0x800 mload add              // [u0, u1, u3, u2, s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup4 dup4 add                            // [t1, u0, u1, u3, u2, s4', s5', s6', s7', s8', s9', s10', ...]
    dup3 dup3 add                            // [t0, t1, u0, u1, u3, u2, s4', s5', s6', s7', s8', s9', ...]
    [PRIME] dup2 dup7 dup1 add addmod        // [t3, t0, t1, u0, u1, u3, u2, s4', s5', s6', s7', s8', ...]
    [PRIME] dup4 dup7 dup1 add addmod        // [t2, t3, t0, t1, u0, u1, u3, u2, s4', s5', s6', s7', ...]
    [PRIME] dup3 dup2 dup7 0x4 mulmod addmod // [s3', t2, t3, t0, t1, u0, u1, u3, u2, s4', s5', s6', ...]
    [PRIME] dup3 dup3 addmod                 // [s2', s3', t2, t3, t0, t1, u0, u1, u3, u2, s4', s5', ...]
    [PRIME] dup4 dup2 dup8 0x4 mulmod addmod // [s1', s2', s3', t2, t3, t0, t1, u0, u1, u3, u2, s4', ...]
    [PRIME] dup6 dup3 addmod                 // [s0', s1', s2', s3', t2, t3, t0, t1, u0, u1, u3, u2, ...]
    swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]

    // State to memory
    dup1 0x0 mstore                          // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup2 0x20 mstore                         // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup3 0x40 mstore                         // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup4 0x60 mstore                         // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup5 0x80 mstore                         // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup6 0xa0 mstore                         // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup7 0xc0 mstore                         // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup8 0xe0 mstore                         // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup9 0x100 mstore                        // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup10 0x120 mstore                       // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup11 0x140 mstore                       // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup12 0x160 mstore                       // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup13 0x180 mstore                       // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup14 0x1a0 mstore                       // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup15 0x1c0 mstore                       // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup16 0x1e0 mstore                       // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]
}

/// @notice Part 1 entry: calldata = 16 words (reduced mod PRIME), returns the 16 words of the permutation output
#define macro MAIN() = {
    SETUP()                              // [PRIME]
    dup1 0x1e0 calldataload mod dup1 0x440 mstore // [s15, PRIME]
    dup2 0x1c0 calldataload mod dup1 0x420 mstore // [s14, s15, PRIME]
    dup3 0x1a0 calldataload mod dup1 0x400 mstore // [s13, s14, s15, PRIME]
    dup4 0x180 calldataload mod          // [s12, s13, s14, s15, PRIME]
    dup5 0x160 calldataload mod          // [s11, s12, s13, s14, s15, PRIME]
    dup6 0x140 calldataload mod          // [s10, s11, s12, s13, s14, s15, PRIME]
    dup7 0x120 calldataload mod          // [s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup8 0x100 calldataload mod          // [s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup9 0xe0 calldataload mod           // [s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup10 0xc0 calldataload mod          // [s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup11 0xa0 calldataload mod          // [s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup12 0x80 calldataload mod          // [s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup13 0x60 calldataload mod          // [s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup14 0x40 calldataload mod          // [s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup15 0x20 calldataload mod          // [s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]
    dup16 0x0 calldataload mod           // [s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, PRIME]

    POSEIDON2_PART()                     // state at memory [0, 0x200)

    0x200 0x0 return
}
