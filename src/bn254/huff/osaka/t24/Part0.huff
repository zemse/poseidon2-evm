    dup16 0x2c0 mstore                       // [s0', s11', s13', s12', s19', s18', s16', s17', s15', s14', s1', P, ...]
    0x740 mload 0x2e0 mstore                 // [s0', s11', s13', s12', s19', s18', s16', s17', s15', s14', s1', P, ...]
}

/// @notice Part 0 entry: calldata = 24 words (reduced mod PRIME), returns what part 1 returns
#define macro MAIN() = {
    SETUP()                              // [PRIME]
    dup1 0x2e0 calldataload mod dup1 0x8e0 mstore // [s23, PRIME]
    dup2 0x2c0 calldataload mod dup1 0x8c0 mstore // [s22, s23, PRIME]
    dup3 0x2a0 calldataload mod dup1 0x8a0 mstore // [s21, s22, s23, PRIME]
    dup4 0x280 calldataload mod dup1 0x880 mstore // [s20, s21, s22, s23, PRIME]
    dup5 0x260 calldataload mod dup1 0x860 mstore // [s19, s20, s21, s22, s23, PRIME]
    dup6 0x240 calldataload mod dup1 0x840 mstore // [s18, s19, s20, s21, s22, s23, PRIME]
    dup7 0x220 calldataload mod dup1 0x820 mstore // [s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup8 0x200 calldataload mod dup1 0x800 mstore // [s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup9 0x1e0 calldataload mod dup1 0x7e0 mstore // [s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup10 0x1c0 calldataload mod dup1 0x7c0 mstore // [s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup11 0x1a0 calldataload mod dup1 0x7a0 mstore // [s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup12 0x180 calldataload mod dup1 0x780 mstore // [s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup13 0x160 calldataload mod dup1 0x760 mstore // [s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup14 0x140 calldataload mod dup1 0x740 mstore // [s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup15 0x120 calldataload mod dup1 0x720 mstore // [s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup16 0x100 calldataload mod dup1 0x700 mstore // [s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0xe0 calldataload mod dup1 0x6e0 mstore // [s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0xc0 calldataload mod dup1 0x6c0 mstore // [s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0xa0 calldataload mod dup1 0x6a0 mstore // [s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0x80 calldataload mod dup1 0x680 mstore // [s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0x60 calldataload mod dup1 0x660 mstore // [s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0x40 calldataload mod dup1 0x640 mstore // [s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0x20 calldataload mod dup1 0x620 mstore // [s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0x0 calldataload mod dup1 0x600 mstore // [s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]

    POSEIDON2_PART()                     // state at memory [0, 0x300)

    // forward the state to part 1 and return its output
    0x300 0x0 0x300 0x0 NEXT_PART() gas staticcall // [success]
    returndatasize 0x300 eq and ok jumpi
    0x0 0x0 revert
    ok:
    0x300 0x0 return
}

/// @notice Address of part 1: the word the deployer appends to the initcode, which CONSTRUCTOR keeps behind the runtime code
#define macro NEXT_PART() = {
    0x20 0x20 codesize sub 0x300 codecopy // memory[0x300] = address word
    0x300 mload                          // [next]
}

/// @notice Deploys the runtime code together with the word appended to the initcode
#define macro CONSTRUCTOR() = {
    __codesize(CONSTRUCTOR)              // [c]
    dup1 codesize sub                    // [len, c]
    dup1 swap2 0x0 codecopy              // [len]
    0x0 return
}
