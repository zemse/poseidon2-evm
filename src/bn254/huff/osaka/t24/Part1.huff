    [PRIME] 0x880 mload 0x360 mload mulmod dup9 add // [s3', s4', s5', s6', s7', s8', s9', s10', sum, s11', s12', s13', ...]
    [PRIME] 0x8a0 mload 0x340 mload mulmod dup10 add // [s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, s11', s12', ...]
    [PRIME] 0x8e0 mload 0x320 mload mulmod dup11 add // [s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, s11', ...]
    [PRIME] 0x600 mload 0x300 mload mulmod dup12 add // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]

    // State to memory
    dup1 0x0 mstore                          // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    dup2 0x20 mstore                         // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    dup3 0x40 mstore                         // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    dup4 0x60 mstore                         // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    dup5 0x80 mstore                         // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    dup6 0xa0 mstore                         // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    dup7 0xc0 mstore                         // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    dup8 0xe0 mstore                         // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    dup9 0x100 mstore                        // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    dup10 0x120 mstore                       // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    dup11 0x140 mstore                       // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    dup13 0x160 mstore                       // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    dup14 0x180 mstore                       // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    dup15 0x1a0 mstore                       // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    0x620 mload 0x1c0 mstore                 // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    0x640 mload 0x1e0 mstore                 // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    0x660 mload 0x200 mstore                 // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    0x680 mload 0x220 mstore                 // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    0x6a0 mload 0x240 mstore                 // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    0x6c0 mload 0x260 mstore                 // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    0x6e0 mload 0x280 mstore                 // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    0x700 mload 0x2a0 mstore                 // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    0x720 mload 0x2c0 mstore                 // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
    dup16 0x2e0 mstore                       // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', sum, ...]
}

/// @notice Part 1 entry: calldata = 24 words (reduced mod PRIME), returns what part 2 returns
#define macro MAIN() = {
    SETUP()                              // [PRIME]
    dup1 0x2e0 calldataload mod dup1 0x740 mstore // [s23, PRIME]
    dup2 0x2c0 calldataload mod dup1 0x720 mstore // [s22, s23, PRIME]
    dup3 0x2a0 calldataload mod dup1 0x700 mstore // [s21, s22, s23, PRIME]
    dup4 0x280 calldataload mod dup1 0x6e0 mstore // [s20, s21, s22, s23, PRIME]
    dup5 0x260 calldataload mod dup1 0x6c0 mstore // [s19, s20, s21, s22, s23, PRIME]
    dup6 0x240 calldataload mod dup1 0x6a0 mstore // [s18, s19, s20, s21, s22, s23, PRIME]
    dup7 0x220 calldataload mod dup1 0x680 mstore // [s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup8 0x200 calldataload mod dup1 0x660 mstore // [s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup9 0x1e0 calldataload mod dup1 0x640 mstore // [s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup10 0x1c0 calldataload mod dup1 0x620 mstore // [s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup11 0x1a0 calldataload mod dup1 0x600 mstore // [s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup12 0x180 calldataload mod         // [s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup13 0x160 calldataload mod         // [s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup14 0x140 calldataload mod         // [s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup15 0x120 calldataload mod         // [s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    dup16 0x100 calldataload mod         // [s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0xe0 calldataload mod        // [s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0xc0 calldataload mod        // [s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0xa0 calldataload mod        // [s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0x80 calldataload mod        // [s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0x60 calldataload mod        // [s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0x40 calldataload mod        // [s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0x20 calldataload mod        // [s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]
    [PRIME] 0x0 calldataload mod         // [s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, PRIME]

    POSEIDON2_PART()                     // state at memory [0, 0x300)

    // forward the state to part 2 and return its output
    0x300 0x0 0x300 0x0 NEXT_PART() gas staticcall // [success]
    returndatasize 0x300 eq and ok jumpi
    0x0 0x0 revert
    ok:
    0x300 0x0 return
}

/// @notice Address of part 2: the word the deployer appends to the initcode, which CONSTRUCTOR keeps behind the runtime code
#define macro NEXT_PART() = {
    0x20 0x20 codesize sub 0x300 codecopy // memory[0x300] = address word
    0x300 mload                          // [next]
}

/// @notice Deploys the runtime code together with the word appended to the initcode
#define macro CONSTRUCTOR() = {
    __codesize(CONSTRUCTOR)              // [c]
    dup1 codesize sub                    // [len, c]
    dup1 swap2 0x0 codecopy              // [len]
    0x0 return
}
