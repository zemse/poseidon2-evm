    swap6 add                                // [d1, t0, P, d3, t1, s3', s4', s5', s6', s7', s8', s9', ...]
    dup3 dup7 dup3 add                       // [b2, P, d1, t0, P, d3, t1, s3', s4', s5', s6', s7', ...]
    dup7 addmod                              // [s2', d1, t0, P, d3, t1, s3', s4', s5', s6', s7', s8', ...]
    swap5 dup4 dup4 0x4 mulmod               // [q0, t1, d1, t0, P, d3, s2', s3', s4', s5', s6', s7', ...]
    dup5 swap3 add                           // [a1, t1, P, t0, P, d3, s2', s3', s4', s5', s6', s7', ...]
    addmod                                   // [s1', t0, P, d3, s2', s3', s4', s5', s6', s7', s8', s9', ...]
    dup1 swap4 add                           // [b0, t0, P, s1', s2', s3', s4', s5', s6', s7', s8', s9', ...]
    addmod                                   // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]

}
