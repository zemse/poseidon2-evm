    DUP136() dup4 dup2 dup8 0x4 mulmod addmod // [s5', s6', s7', t2, t3, t0, t1, u4, u5, u6, u7, s8', ...]
    DUP137() dup6 dup3 addmod                // [s4', s5', s6', s7', t2, t3, t0, t1, u4, u5, u6, u7, ...]
    swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop // [s4', s5', s6', s7', s8', s9', s10', s11', s12', s13', s14', s15', ...]
    DUP28() DUP22() add                      // [u0, s4', s5', s6', s7', s8', s9', s10', s11', s12', s13', s14', ...]
    DUP28() DUP24() add                      // [u1, u0, s4', s5', s6', s7', s8', s9', s10', s11', s12', s13', ...]
    DUP28() DUP27() add                      // [u3, u1, u0, s4', s5', s6', s7', s8', s9', s10', s11', s12', ...]
    DUP28() DUP27() add                      // [u2, u3, u1, u0, s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup2 dup2 add                            // [t1, u2, u3, u1, u0, s4', s5', s6', s7', s8', s9', s10', ...]
    dup5 dup5 add                            // [t0, t1, u2, u3, u1, u0, s4', s5', s6', s7', s8', s9', ...]
    DUP136() dup2 dup6 dup1 add addmod       // [t3, t0, t1, u2, u3, u1, u0, s4', s5', s6', s7', s8', ...]
    DUP137() dup4 dup8 dup1 add addmod       // [t2, t3, t0, t1, u2, u3, u1, u0, s4', s5', s6', s7', ...]
    DUP138() dup3 dup2 dup7 0x4 mulmod addmod // [s3', t2, t3, t0, t1, u2, u3, u1, u0, s4', s5', s6', ...]
    DUP139() dup3 dup3 addmod                // [s2', s3', t2, t3, t0, t1, u2, u3, u1, u0, s4', s5', ...]
    DUP140() dup4 dup2 dup8 0x4 mulmod addmod // [s1', s2', s3', t2, t3, t0, t1, u2, u3, u1, u0, s4', ...]
    DUP141() dup6 dup3 addmod                // [s0', s1', s2', s3', t2, t3, t0, t1, u2, u3, u1, u0, ...]
    swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop swap4 pop // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]

}
