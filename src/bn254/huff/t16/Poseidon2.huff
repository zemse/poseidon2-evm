    dupn 21 dup9 add dupn 37 dup12 add dupn 77 dupn 25 dup13 add dup3 add // [t1, P, u15, u13, u11, u9, u7, u5, u3, u1, S0, S1, ...]
    dup4 dup1 add                            // [d1, t1, P, u15, u13, u11, u9, u7, u5, u3, u1, S0, ...]
    dup3 dupn 26 dup14 add dup7 add          // [t0, P, d1, t1, P, u15, u13, u11, u9, u7, u5, u3, ...]
    dup6 dup1 add                            // [d3, t0, P, d1, t1, P, u15, u13, u11, u9, u7, u5, ...]
    dup3 dup1 dup4 0x4 mulmod                // [q0, P, d3, t0, P, d1, t1, P, u15, u13, u11, u9, ...]
    dup6 add                                 // [a1, P, d3, t0, P, d1, t1, P, u15, u13, u11, u9, ...]
    dup7 addmod                              // [s13', d3, t0, P, d1, t1, P, u15, u13, u11, u9, u7, ...]
    dup4 dup2 dup4 add                       // [b0, P, s13', d3, t0, P, d1, t1, P, u15, u13, u11, ...]
    dup5 addmod                              // [s12', s13', d3, t0, P, d1, t1, P, u15, u13, u11, u9, ...]
    msize mstore                             // [s13', d3, t0, P, d1, t1, P, u15, u13, u11, u9, u7, ...]
    msize mstore                             // [d3, t0, P, d1, t1, P, u15, u13, u11, u9, u7, u5, ...]
    dup3 dup6 0x4 mulmod                     // [q1, d3, t0, P, d1, t1, P, u15, u13, u11, u9, u7, ...]
    add                                      // [a3, t0, P, d1, t1, P, u15, u13, u11, u9, u7, u5, ...]
    addmod                                   // [s15', d1, t1, P, u15, u13, u11, u9, u7, u5, u3, u1, ...]
    dup1 0x1e0 mstore                        // [s15', d1, t1, P, u15, u13, u11, u9, u7, u5, u3, u1, ...]
    add                                      // [b2, t1, P, u15, u13, u11, u9, u7, u5, u3, u1, S0, ...]
    addmod                                   // [s14', u15, u13, u11, u9, u7, u5, u3, u1, S0, S1, S2, ...]
    0x1c0 mstore                             // [u15, u13, u11, u9, u7, u5, u3, u1, S0, S1, S2, S3, ...]


    msize 0x0 return
}
