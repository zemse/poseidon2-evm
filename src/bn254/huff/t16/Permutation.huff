    DUP20() dup13 add                        // [u5, u6, u7, s8', s9', s10', s11', s12', s13', s14', s15', S0, ...]
    DUP20() dup13 add                        // [u4, u5, u6, u7, s8', s9', s10', s11', s12', s13', s14', s15', ...]
    dup2 add                                 // [t0, u5, u6, u7, s8', s9', s10', s11', s12', s13', s14', s15', ...]
    swap2 DUP37() dup4 dup6 dup1 add         // [2s3, t0, P, u6, u5, t0, u7, s8', s9', s10', s11', s12', ...]
    addmod                                   // [t3, u6, u5, t0, u7, s8', s9', s10', s11', s12', s13', s14', ...]
    swap2 dup1 add                           // [2s1, u6, t3, t0, u7, s8', s9', s10', s11', s12', s13', s14', ...]
    swap4 add                                // [t1, t3, t0, 2s1, s8', s9', s10', s11', s12', s13', s14', s15', ...]
    DUP37() dup1 dup1 swap3 dup2 dup6 dup2 dup4 0x4 mulmod // [4t1, t3, P, t1, P, P, P, t3, t0, 2s1, s8', s9', ...]
    addmod                                   // [s7', t1, P, P, P, t3, t0, 2s1, s8', s9', s10', s11', ...]
    swap7 addmod                             // [t2, P, P, t3, t0, s7', s8', s9', s10', s11', s12', s13', ...]
    dup2 dup1 dup8 dup4 addmod               // [s6', P, t2, P, P, t3, t0, s7', s8', s9', s10', s11', ...]
    swap6 0x4 mulmod                         // [4t0, t2, P, P, t3, s6', s7', s8', s9', s10', s11', s12', ...]
    addmod                                   // [s5', P, t3, s6', s7', s8', s9', s10', s11', s12', s13', s14', ...]
    swap2 dup3 addmod                        // [s4', s5', s6', s7', s8', s9', s10', s11', s12', s13', s14', s15', ...]
    DUP20() DUP17() add                      // [u3, s4', s5', s6', s7', s8', s9', s10', s11', s12', s13', s14', ...]
    DUP20() DUP17() add                      // [u2, u3, s4', s5', s6', s7', s8', s9', s10', s11', s12', s13', ...]
    DUP20() DUP17() add                      // [u1, u2, u3, s4', s5', s6', s7', s8', s9', s10', s11', s12', ...]
    DUP20() DUP17() add                      // [u0, u1, u2, u3, s4', s5', s6', s7', s8', s9', s10', s11', ...]
    dup2 add                                 // [t0, u1, u2, u3, s4', s5', s6', s7', s8', s9', s10', s11', ...]
    swap2 DUP41() dup4 dup6 dup1 add         // [2s3, t0, P, u2, u1, t0, u3, s4', s5', s6', s7', s8', ...]
    addmod                                   // [t3, u2, u1, t0, u3, s4', s5', s6', s7', s8', s9', s10', ...]
    swap2 dup1 add                           // [2s1, u2, t3, t0, u3, s4', s5', s6', s7', s8', s9', s10', ...]
    swap4 add                                // [t1, t3, t0, 2s1, s4', s5', s6', s7', s8', s9', s10', s11', ...]
    DUP41() dup1 dup1 swap3 dup2 dup6 dup2 dup4 0x4 mulmod // [4t1, t3, P, t1, P, P, P, t3, t0, 2s1, s4', s5', ...]
    addmod                                   // [s3', t1, P, P, P, t3, t0, 2s1, s4', s5', s6', s7', ...]
    swap7 addmod                             // [t2, P, P, t3, t0, s3', s4', s5', s6', s7', s8', s9', ...]
    dup2 dup1 dup8 dup4 addmod               // [s2', P, t2, P, P, t3, t0, s3', s4', s5', s6', s7', ...]
    swap6 0x4 mulmod                         // [4t0, t2, P, P, t3, s2', s3', s4', s5', s6', s7', s8', ...]
    addmod                                   // [s1', P, t3, s2', s3', s4', s5', s6', s7', s8', s9', s10', ...]
    swap2 dup3 addmod                        // [s0', s1', s2', s3', s4', s5', s6', s7', s8', s9', s10', s11', ...]

}
